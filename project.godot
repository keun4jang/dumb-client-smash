; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but you can edit this file for quick tweaks too.
; Manually editing this file is STRONGLY NOT RECOMMENDED.

config_version=5

[application]

config/name="멍청한 거래처 줘패기"
config/description="A mobile hyper-casual stress relief game."
run/main_scene="res://scenes/main/MainMenu.tscn"
config/features=PackedStringArray("4.2", "Mobile")
config/icon="res://icon.svg"

[autoload]

SaveManager="*res://scripts/core/SaveManager.gd"
GameManager="*res://scripts/core/GameManager.gd"
StageManager="*res://scripts/core/StageManager.gd"
HapticManager="*res://scripts/feedback/HapticManager.gd"
AudioManager="*res://scripts/feedback/AudioManager.gd"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input]

ui_touch={
"deadzone": 0.5,
"events": [Object(InputEventScreenTouch,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"index":0,"position":Vector2(0, 0),"canceled":false,"pressed":false,"double_tap":false,"script":null)
]
}

[gui]

theme/custom_font="res://assets/fonts/NotoSansKR-Regular.ttf"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"
